meta {
  name: Logout
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/v1/auth/logout
  body: none
  auth: none
}

headers {
  X-CSRF-Protection: 1
}

tests {
  test("Expected HTTP 204", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Revokes the currently presented refresh session and clears both cookies. Access JWTs remain valid until expiry for existing accounts.
}
