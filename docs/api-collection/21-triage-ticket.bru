meta {
  name: Triage ticket
  type: http
  seq: 21
}

patch {
  url: {{baseUrl}}/api/v1/tickets/{{ticketId}}
  body: json
  auth: none
}

headers {
  X-CSRF-Protection: 1
  Content-Type: application/json
}

body:json {
  {
    "status": "IN_PROGRESS",
    "priority": "HIGH",
    "assignedTo": "{{userId}}"
  }
}

tests {
  test("Expected HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Success envelope", function () {
    expect(res.getBody()).to.have.property("data");
  });
}

docs {
  Staff only fields. Assignment requires AGENT/ADMIN or null. Allowed transitions: OPEN -> IN_PROGRESS -> RESOLVED -> CLOSED; RESOLVED -> OPEN.
}
