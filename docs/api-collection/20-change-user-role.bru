meta {
  name: Change user role
  type: http
  seq: 20
}

patch {
  url: {{baseUrl}}/api/v1/users/{{userId}}/role
  body: json
  auth: none
}

headers {
  X-CSRF-Protection: 1
  Content-Type: application/json
}

body:json {
  {
    "role": "AGENT"
  }
}

tests {
  test("Expected HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Success envelope", function () {
    expect(res.getBody()).to.have.property("data");
  });
}

docs {
  ADMIN only. Promotes the sample user to AGENT so it can be assigned the sample ticket. An ADMIN cannot demote themselves.
}
