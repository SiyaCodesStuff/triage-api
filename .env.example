NODE_ENV=development
PORT=3000
# Number of reverse-proxy hops to trust (0 disables proxy trust).
TRUST_PROXY=0
DATABASE_URL=postgres://triage:triage@localhost:5432/triage
TEST_DATABASE_URL=postgres://triage:triage@localhost:5432/triage_test
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CORS_ORIGINS=http://localhost:5173
POSTGRES_USER=triage
POSTGRES_PASSWORD=triage
POSTGRES_DB=triage
POSTGRES_PORT=5432
